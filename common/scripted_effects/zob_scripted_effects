spawn_zob = {
	spawn_system = { 
		min_distance = 20
		max_distance = 50
		initializer = "zob_system"
		hyperlane = yes
	}
	last_created_system = {
		ordered_neighbor_system_euclidean = {
			limit = {
				not = {
					has_hyperlane_to = prev 
				}
			}
			add_hyperlane = {
				from = this
				to = prev
			}
	  	}
		ordered_neighbor_system_euclidean = {
			limit = {
				not = {
					has_hyperlane_to = prev 
				}
			}
			add_hyperlane = {
				from = this
				to = prev
			}
	  	}
	}
	set_global_flag = zob_system_spawned
	###TODO figure out nebula object on galaxy map
}

