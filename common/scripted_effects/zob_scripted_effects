track_zob_variable = {
	optimize_memory
	set_variable = {
		which = zob_$trait$
		value = 0	
	}
}

#Gives a 1 or 0 for having each tracked trait
set_zob_variable = {
	optimize_memory
	if = {
		limit = {
			has_trait = $trait$
		}
		change_variable = {
			which = zob_$trait$
			value = 1	
		}
		owner = {
			change_variable = {
				which = zob_$trait$
				value = 1
			}
		}
	}
}

