#If the leaders local variable is 0 but they have the trait, they recently gained it. Saves variable, and increments the country level tracker for collected traits
update_zob_variable = {
    optimize_memory
	if = {
		limit = {
			check_variable = {
				which = zob_$trait$
				value = 0
			}
			has_trait = $trait$
		}
		change_variable = {
			which = zob_$trait$
			value = 1
		}
		owner = {
			change_variable = {
				which = zob_$trait$
				value = 1
			}
		}
	}
}

