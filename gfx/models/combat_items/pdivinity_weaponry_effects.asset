#############
### laser ###
#############

# small

entity = {
	name = "pdivinity_laser_small_hit_entity"
	cull_radius = 1.0
	default_state = "idle"
	state = { name = "idle"
		start_event = { particle = pdivinity_laser_small_hit_effect sound = { soundeffect = laser_hit } }
		start_event = { trigger_once = yes sound = { soundeffect = "distance_laser_hit" } }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

entity = {
	name = "pdivinity_laser_small_shield_hit_entity"
	cull_radius = 1.0
	default_state = "idle"
	state = { name = "idle"
		start_event = { particle = pdivinity_laser_small_hit_effect sound = { soundeffect = shield_hit } }
		start_event = { particle = laser_small_shield_hit_effect }
		start_event = { trigger_once = yes sound = { soundeffect = "distance_shield_hit" } }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

entity = {
	name = "pdivinity_laser_small_muzzle_entity"
	pdxmesh = "locator_mesh"

	default_state = "idle"
	state = { name = "idle" state_time = 1 looping = no
		event = { time = 0 particle = "pdivinity_laser_small_muzzle_particle" keep_particle = yes sound = { soundeffect = laser_fire } }
		event = { trigger_once = yes sound = { soundeffect = "distance_laser_fire" } }
	}
}

