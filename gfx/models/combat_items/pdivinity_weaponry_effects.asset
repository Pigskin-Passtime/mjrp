entity = {
	name = "pdivinity_psionic_muzzle_entity"
	cull_radius = 1.0

	default_state = "idle"
	state = { name = "idle" state_time = 0.8 looping = no
		event = { time = 0 particle = "pdivinity_psionic_lance_muzzle_particle" keep_particle = yes sound = { soundeffect = tachyon_lance_fire } }
		event = { trigger_once = yes sound = { soundeffect = "distance_tachyon_lance_fire" } }
	}
}

entity = {
	name = "pdivinity_lance_windup_entity"

	default_state = "attack"
	get_state_from_parent = no
	state = {
		name = "attack" looping = yes state_time = 0.8
		event = { trigger_once = yes sound = { soundeffect = "tachyon_lance_windup" } }

		event = { time = 0.0 use_parent_nodes = yes node = xl_windup_8 particle = "pdivinity_lance_windup_effect" }
		event = { time = 0.0 use_parent_nodes = yes node = xl_windup_7 particle = "pdivinity_lance_windup_effect" }
		event = { time = 0.2 use_parent_nodes = yes node = xl_windup_6 particle = "pdivinity_lance_windup_effect" }
		event = { time = 0.2 use_parent_nodes = yes node = xl_windup_5 particle = "pdivinity_lance_windup_effect" }
		event = { time = 0.4 use_parent_nodes = yes node = xl_windup_4 particle = "pdivinity_lance_windup_effect" }
		event = { time = 0.4 use_parent_nodes = yes node = xl_windup_3 particle = "pdivinity_lance_windup_effect" }
		event = { time = 0.6 use_parent_nodes = yes node = xl_windup_2 particle = "pdivinity_lance_windup_effect" }
		event = { time = 0.6 use_parent_nodes = yes node = xl_windup_1 particle = "pdivinity_lance_windup_effect" }

		event = { time = 0.0 use_parent_nodes = yes node = xl_gun_01 particle = "pdivinity_psionic_lance_muzzle_windup_effect" trigger_once = yes keep_particle = yes }
	}
}

entity = {
	name = "pdivinity_psionic_lance_turret_windup_entity"

	default_state = "attack"
	get_state_from_parent = no
	state = {
		name = "attack" looping = yes state_time = 0.8
		event = { trigger_once = yes sound = { soundeffect = "tachyon_lance_windup" } }

		event = { time = 0.0 use_parent_nodes = yes node = turret_muzzle_01 particle = "pdivinity_psionic_lance_muzzle_windup_effect" trigger_once = yes keep_particle = yes }
	}
}

