@corvette_scale = 4.0

entity = {
	name = "MJ25_WH_aural_starmass_entity"
	pdxmesh = "MJ25_WH_aural_starmass_frame_mesh"

	default_state = "idle"
	
	state = { name = "idle" animation = "idle" animation_blend_time = 0.25
		start_event = { trigger_once = yes sound = { soundeffect = "MJ25_WH_silent_witness_ambient" } }
		
	}
	state = { name = "death" animation = "death" animation_speed = 2.1 looping = no
		event = { time = 0.1 node = "core" particle = "MJ25_WH_aural_starmass_death_start" sound = { soundeffect = MJ25_WH_conductor_death } }
		event = { time = 5 node = "core" particle = "MJ25_WH_conductor_death_end" sound = { soundeffect = extra_dimensional_station_death } }
	}

	game_data = {
		size = 30.0	
	  	raytrace_projectiles = no
  		dissolve_on_death = 3.0
		ship_color = hsv { 0.11 1.0 0.75 1.0 }    
	}

    scale = 1.2

}

entity = {
	name = "MJ25_WH_aural_starmass_hull_entity"
	pdxmesh = "MJ25_WH_aural_starmass_mesh"
	
	scale = 3.0
	
	default_state = "idle"

	state = { name = "idle" animation = "idle" animation_blend_time = 0.25
		event = { time = 0 node = "core" particle = "MJ25_WH_aural_starmass_effect" keep_particle = yes trigger_once = yes }
	}

	state = { name = "death" animation = "death" animation_speed = 2 animation_blend_time = 0.25 looping = no
	}

	game_data = {
		uv_animation_speed 		= 3.0
		uv_animation_direction 	= { 0.0 0.02 }
		bloom_factor = 1.25
	}
	
	# { minor_axis_x vertical_shift_z major_axis_y }
	# locator = { name = "temp_01" position = { 0.0 0.0 0.0 } }
	# locator = { name = "hangar_02" position = { 10.2 -3.3 -15.6 } }
	# locator = { name = "hangar_03" position = { -10.2 -3.3 8.4 } }
	
	# state = { name = "idle"
	# 	start_event = { trigger_once = yes sound = { soundeffect = "MJ25_WH_silent_witness_ambient" } }
	# }
}