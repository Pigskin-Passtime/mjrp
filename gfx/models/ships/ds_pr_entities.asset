# Rift Monster

entity = {
	name = "ds_pr_monster_entity"
	scale = 15
	default_state = "idle"
	state = { name = "idle" 		state_time = 5
		event = { time = 0 node = "core" particle = "ds_pr_storm_effect" keep_particle = yes trigger_once = yes }
		start_event = { 
			trigger_once = yes 
			sound = { soundeffect = "sfx_amb_psi_storm_1" } 
		}
	}
	locator = { name = "core" position = { 0 -5 0 } }
	locator = { name = "core2" position = { 0 -6.5 0 } }
	attach = { core = "psi_storm_core_entity" }
	locator = { name = "tentacle1" position = { 7.5 -6 0 } rotation = { 90 0 0 } }
	locator = { name = "tentacle2" position = { -7.5 -6 0 } rotation = { 270 0 0 } }
	locator = { name = "tentacle3" position = { 0 -6 7.5 } rotation = { 0 0 0 } }
	locator = { name = "tentacle4" position = { 0 -6 -7.5 } rotation = { 180 0 0 } }
	attach = { tentacle1 = "ds_pr_rift_tentacle_entity" }
	attach = { tentacle2 = "ds_pr_rift_tentacle_entity" }
	attach = { tentacle3 = "ds_pr_rift_tentacle_entity" }
	attach = { tentacle4 = "ds_pr_rift_tentacle_entity" }
	locator = { name = "tentacle5" position = { 5.5 -6 5.5 } rotation = { 45 0 0 } }
	locator = { name = "tentacle6" position = { 5.5 -6 -5.5 } rotation = { 135 0 0 } }
	locator = { name = "tentacle7" position = { -5.5 -6 5.5 } rotation = { 315 0 0 } }
	locator = { name = "tentacle8" position = { -5.5 -6 -5.5 } rotation = { 225 0 0 } }
	attach = { tentacle5 = "ds_pr_rift_tentacle2_entity" }
	attach = { tentacle6 = "ds_pr_rift_tentacle2_entity" }
	attach = { tentacle7 = "ds_pr_rift_tentacle2_entity" }
	attach = { tentacle8 = "ds_pr_rift_tentacle2_entity" }
	attach = { core2 = "ds_pr_monster_portal_entity" }
	attach = { core2 = "ds_pr_monster_ring_entity" }
	cull_radius = 750
}

entity = {
	name = "ds_pr_rift_tentacle_entity"
	pdxmesh = "dimensional_horror_appendage_mesh"
	default_state = "idle"
	state = { name = "idle" animation = "attack" looping = yes
		event = { time = 0 node = "portal_locator" particle = "dimensional_horror_appendage_effect" keep_particle = yes trigger_once = yes }
		event = { sound = { soundeffect = "dimensional_horror_tentacle_attack" } }
		event = { sound = { soundeffect = "distance_dimensional_horror_tentacle_attack" } }
	}
	scale = 0.11
	playback_rate = 0.15
}

