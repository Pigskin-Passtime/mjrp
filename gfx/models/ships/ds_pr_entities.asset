# Rift

entity = {
	name = "ds_pr_rift_star_entity"
	# ed_star_class_star_entity
	pdxmesh = "star_mesh"
	locator = { name = "core" position = { 0 0 0 } }
	default_state = "idle"
	state = { name = "idle" animation = "idle"
		event = { time = 0.0 node = "planet" particle = "ds_pr_rift_star_effect"  keep_particle = no trigger_once = yes sound = { soundeffect = "amb_star_fusion" } }
	}
	attach = { core = "ds_pr_rift_star_effect_entity" }
	cull_radius = 1000
	scale = 1.6
}

