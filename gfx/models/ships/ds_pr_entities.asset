# Osiris - planet

entity = {
	name = "ds_pr_anomaly_entity"
	pdxmesh = "planet_no_pole_no_clouds_mesh"
	meshsettings = {
		name = "planet_geosphereShape"
		texture_diffuse = "cold_barren_01_diffuse.dds"
		texture_normal = "barren_01_normal.dds"
		texture_specular = "barren_01_specular.dds"
		shader = PdxMeshBlackHole
	}
	default_state = "idle"
	playback_rate = -1.0 # Rotation is reversed
	state = { name = "idle" animation = "idle" time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "blackhole_hum_idle" } }
	}
	game_data = { bloom_factor = 2 }
}
