###############
### stage 1 ###
###############

entity = {
	name = pdivinity_shroud_needle_stage_1_entity
	locator = {
		name = "z_offset"
		position = { 0 400 0 }
	}
	cull_radius = 10000

	attach = { "z_offset" = "pdivinity_shroud_needle_stage_1_entity_mesh" }
}

entity = {
	name = "pdivinity_shroud_needle_stage_1_entity_mesh"
	pdxmesh = "pdivinity_shroud_needle_stage_1_mesh"

	scale = 3.0

	meshsettings = {
		name = "MeshShape"
		index = 0
		texture_diffuse = "pdivinity_fallen_empire_station_purple.dds"
		texture_normal = "fallen_empire_stations_normal.dds"
		texture_specular = "fallen_empire_stations_specular.dds"
		shader = "PdxMeshShip"
	}

	## look at the below later



	default_state = "idle"
	state = { name = "idle"
		start_event = { node = "effect_1" particle = "pdivinity_big_beam_structure_effect" keep_particle = yes trigger_once = yes }
	}
}

