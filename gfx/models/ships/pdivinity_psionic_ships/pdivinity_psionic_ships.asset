### dimensional tearer


entity = {
	name = "pdivinity_dimensional_tearer_entity"
	pdxmesh = "molluscoid_01_corvette_frame_mesh"
	scale = 1.5

	default_state = "idle"
	state = { name = "idle" animation = "idle" }
	state = { name = "death" animation = "death" looping = no }
}

entity = {
	name = "pdivinity_dimensional_mid_section"
	pdxmesh = "pdivinity_dimensional_tearer_mesh"
	scale = 1.5


	default_state = "idle"
	state = { name = "idle" animation = "idle"
		event = { time = 0	id = "beam_start" }
		event = { time = 0 node = "effect_1" particle = "shroud_creature_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "root" particle = "shroud_creature_cloud_effect" keep_particle = yes trigger_once = yes }
		start_event = { trigger_once = yes sound = { soundeffect = "shroud_creature_idle_low" } }
		start_event = { trigger_once = yes sound = { soundeffect = "shroud_creature_idle_high" } }
		event = { time = 1.2 trigger_once = yes sound = { soundeffect = "shroud_creature_thunder" } }
	}
	state = { name = "death"	animation = "death" animation_blend_time = 0.0 animation_speed = 1 looping = no
		event = { sound = { soundeffect = "shroud_creature_death" } }
	}

	game_data = {
		bloom_factor = 1.0
		uv_animation_speed 		= 2
		uv_animation_direction 	= { -0.05 -0.02 }
	}
}

### dimensional portal

entity = {
	name = "pdivinity_dimensional_portal_entity"
	pdxmesh = "molluscoid_01_corvette_frame_mesh"

	default_state = "idle"
	state = { name = "idle" animation = "idle" }
	state = { name = "death" animation = "death" looping = no }

	scale = 10.0
}

entity = {
	name = "pdivinity_dimensional_portal_mid_section"
	pdxmesh = "pdivinity_dimensional_portal_mesh"

	locator = { name = "part1" 	position = { 0 0 0 } }

	default_state = idle
	state = { name = "idle"		animation = "idle"		animation_blend_time = 0.3
		start_event = { trigger_once = yes sound = { soundeffect = "ex_dimensional_portal_idle" } }

		event = { time = 0 node = "root2" particle = "pdivinity_portal_inner_effect_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "clock_12_locator" particle = "pdivinity_portal_effect_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ex_dimensional_portal_thunder" } }
		event = { time = 0 node = "clock_3_locator" particle = "pdivinity_portal_effect_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ex_dimensional_portal_thunder" } }
		event = { time = 0 node = "clock_6_locator" particle = "pdivinity_portal_effect_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ex_dimensional_portal_thunder" } }
		event = { time = 0 node = "clock_9_locator" particle = "pdivinity_portal_effect_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ex_dimensional_portal_thunder" } }
	}

	scale = 10.0
}

