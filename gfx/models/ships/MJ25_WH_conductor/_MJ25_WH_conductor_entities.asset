@corvette_scale = 4.0

entity = {
	name = "MJ25_WH_conductor_entity"
	pdxmesh = "MJ25_WH_conductor_frame_mesh"

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 0.25
		start_event = { trigger_once = yes sound = { soundeffect = "MJ25_WH_conductor_ambient" } }
		
	}
	state = { name = "death" animation = "death" animation_blend_time = 0.0 state_time = 10

		event = { time = 0.1 node = "orb_locator" particle = "MJ25_WH_conductor_death_start"}
		event = { time = 2.8 node = "small_turret_1" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed }}
		event = { time = 5 node = "small_turret_4" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed }}
		event = { time = 6.6 node = "small_turret_3" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed }}
		event = { time = 7.7 node = "small_turret_2" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed }}
		event = { time = 8.5 node = "large_turret_1" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed }}
		event = { time = 9.1 node = "small_turret_1" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed }}
		event = { time = 9.6 node = "small_turret_3" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed }}
		event = { time = 10 node = "orb_locator" particle = "MJ25_WH_conductor_death_end" sound = { soundeffect = MJ25_WH_conductor_death } }
	}
	

    scale = 1.0
	game_data = {
		size = 25
		emissive_recolor_crunch = 5.0
	}

}

entity = {
	name = "MJ25_WH_conductor_hull_entity"
	pdxmesh = "MJ25_WH_conductor_mesh"
	
	scale = 2.0
	
	default_state = "idle"

	attach = { "orb_locator" = "MJ25_WH_conductor_core_entity" }

	state = { name = "idle" animation = "idle" animation_blend_time = 0.25
		event = { time = 0 node = "orb_locator" particle = "MJ25_WH_conductor_effect" keep_particle = yes trigger_once = yes }
	}
	state = { name = "death" animation = "death" animation_blend_time = 0.0 chance = 1 looping = no
	}
}

entity = {
	name = "MJ25_WH_conductor_core_entity"
	pdxmesh = "MJ25_WH_conductor_core_mesh"
	
	scale = 2.0
	
	default_state = "idle"

	state = { name = "idle"
		# event = { time = 0 node = "orb_locator" particle = "MJ25_WH_conductor_core_effect" keep_particle = yes trigger_once = yes }
	}

	game_data = {
		uv_animation_speed 		= 4.0
		uv_animation_direction 	= { 0.0 0.02 }
		bloom_factor = 0.95
	}
}