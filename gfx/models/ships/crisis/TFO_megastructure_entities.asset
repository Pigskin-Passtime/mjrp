### MOD NAME:
### The Forgotten One
### CONTRIBUTORS:
### AlexMeowler

@TFO_bloom_factor = 4

entity = {
    name = TFO_shroud_research_complex_base
    pdxmesh = mammalian_01_mining_station_mesh

    default_state = idle
    state = { name = idle state_time = 5
        start_event = { trigger_once = yes sound = { soundeffect = amb_mining_station_signals } }

        event = { time = 0.0 node = light_locator_01 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_02 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_03 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_04 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_05 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_06 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_07 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_08 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
        event = { time = 0.0 node = light_locator_09 particle = ship_light_blue_effect keep_particle = yes trigger_once = yes }
    }

    state = { name = death state_time = 5 looping = no
        event = { time = 0.0 node = light_locator_01 particle = ship_explosion_particle keep_particle = yes trigger_once = yes sound = { soundeffect = station_explosion_small } }
        event = { time = 0.5 node = light_locator_02 particle = ship_explosion_particle keep_particle = yes trigger_once = yes sound = { soundeffect = station_explosion_small } }
        event = { time = 1.5 node = light_locator_03 particle = ship_explosion_particle keep_particle = yes trigger_once = yes sound = { soundeffect = station_explosion_small } }
        event = { time = 2.0 node = light_locator_04 particle = ship_explosion_particle keep_particle = yes trigger_once = yes sound = { soundeffect = station_explosion_small } }
        event = { time = 3.0 node = light_locator_05 particle = ship_explosion_particle keep_particle = yes trigger_once = yes sound = { soundeffect = station_explosion_small } }
        event = { time = 4.0 node = light_locator_06 particle = ship_explosion_particle keep_particle = yes trigger_once = yes sound = { soundeffect = station_explosion_small } }
    }
}

entity = {
    name = TFO_shroud_research_complex
    scale = 10.0

    locator = { name = root position = { 0 0 0 } rotation = { 0 0 0 }}

    attach = { root = TFO_shroud_research_complex_base }
}

entity = {
    name = TFO_aetherophasic_testing_grounds
    pdxmesh = mammalian_01_orbital_station_frame_mesh

    attach = { part1 = mammalian_01_habitat_phase_01_core_entity }
    attach = { part2 = mammalian_01_habitat_phase_02_section_entity }
    attach = { part3 = mammalian_01_habitat_phase_02_section_entity }
    attach = { part4 = mammalian_01_habitat_phase_02_section_entity }
    attach = { part5 = mammalian_01_habitat_phase_02_section_entity }
    attach = { part6 = mammalian_01_habitat_phase_02_section_entity }
    attach = { part7 = mammalian_01_habitat_phase_02_section_entity }

    scale = 4

    default_state = habitat_idle
    state = { name = habitat_idle looping = yes }
    state = { name = construction looping = yes }

    game_data = {
        shader_type = ship
        emissive_recolor_crunch = 5.0
    }
}

entity = {
    name = TFO_NMPA_beam_effect
    locator = { name = root position = { 0 0 0 } }

    scale = 0.35

    default_state = attack
    get_state_from_parent = no
    state = {
        name = attack looping = yes state_time = 1


        event = { time = 0.0  use_parent_nodes = yes node = xl_windup_wing_1 particle = nemesis_01_ion_cannon_muzzle_windup_effect trigger_once = yes keep_particle = yes }

        event = { time = 0.00  use_parent_nodes = yes node = xl_windup_wing_1 particle = nemesis_01_perdition_beam_windup_effect trigger_once = no keep_particle = yes }
        event = { time = 0.25  use_parent_nodes = yes node = xl_windup_wing_2 particle = nemesis_01_perdition_beam_windup_effect trigger_once = no keep_particle = yes }
        event = { time = 0.50 use_parent_nodes = yes node = xl_windup_wing_3 particle = nemesis_01_perdition_beam_windup_effect trigger_once = no keep_particle = yes }
        event = { time = 0.75  use_parent_nodes = yes node = xl_windup_wing_4 particle = nemesis_01_perdition_beam_windup_effect trigger_once = no keep_particle = yes }

    }
}

entity = {
    name = TFO_negative_mass_particle_accelerator
    pdxmesh = orbital_ring_tier_01_mesh

    scale = 4

    locator = {
        name = root
    }

    default_state = idle
    state = { name = idle state_time = 5 animation = idle
        event = { trigger_once = yes sound = { soundeffect = place_construction } }
    }

    attach = { part1 = mammalian_01_orbital_ring_section_incomplete_entity }
    attach = { part2 = mammalian_01_orbital_ring_section_incomplete_entity }
    attach = { part3 = mammalian_01_orbital_ring_section_incomplete_entity }
    attach = { part4 = mammalian_01_orbital_ring_section_incomplete_entity }
    attach = { hub1 = mammalian_01_orbital_ring_hub_entity }
    attach = { hub2 = mammalian_01_orbital_ring_hub_entity }
    attach = { hub3 = mammalian_01_orbital_ring_hub_entity }
    attach = { hub4 = mammalian_01_orbital_ring_hub_entity }
    attach = { root = TFO_NMPA_beam_effect }

    cull_radius = 10000000

}