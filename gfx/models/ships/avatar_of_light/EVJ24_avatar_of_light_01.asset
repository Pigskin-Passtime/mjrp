entity = {
	name = "EVJ24_avatar_of_light_clouds_01_entity"
	pdxmesh = "EVJ24_avatar_of_light_clouds_01_mesh"
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" }
	state = { name = "death" animation = "death" looping = no }
	
	game_data = { 
		bloom_factor = 1.0 
		uv_animation_speed 		= 0.02
		uv_animation_direction 	= { -0.05 -1.0 }
	
	}
