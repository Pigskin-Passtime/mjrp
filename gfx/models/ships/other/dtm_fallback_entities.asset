entity = {
	name = "dtm_theophany_psi_core_entity_stage_1"
	#pdxmesh = "space_cloud_mesh"
	locator = { name = "part1" }
	locator = { name = "pos1"	position = { 10	80 	0 } rotation = {	90	-20	0	}  scale = 0.3}
	locator = { name = "pos2"	position = { -30 -80 0 } rotation = {	-90	-20	0	} scale = 0.3}
	locator = { name = "pos3"	position = { 0 0 0 } rotation = {	0	0	0	}  }
	locator = { name = "pos4"	position = { -5	100 -25 } rotation = {	90	-20	0	}  scale = 0.13}
	locator = { name = "pos5"	position = { -15 -45 0 } rotation = {	-90	-20	0	}  scale = 0.13}

	

	game_data = {
		size = 20
	}
	attach = { "pos1" 			= "dtm_theophany_default_ring_2_entity" } 
	attach = { "pos2" 			= "dtm_theophany_default_ring_2_entity" }
	attach = { "pos3" 			= "crystal_rift_entity" }
	attach = { "pos4"			= "dtm_theophany_default_ring_1_entity" }
	attach = { "pos5"			= "dtm_theophany_default_ring_1_entity" }
	scale = 1
}

