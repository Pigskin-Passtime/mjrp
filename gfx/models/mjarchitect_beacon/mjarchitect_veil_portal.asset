entity = {
	name = "mjarchitect_veil_portal_entity"
	pdxmesh = "mjarchitect_veil_portal_mesh"
	
	scale = 2
	default_state = "idle"
	state = { name = "idle" state_time = 5
		event = { time = 0 particle = "black_hole_particle" trigger_once = yes keep_particle = yes }
		# event = { trigger_once = yes sound = { soundeffect = "blackhole_hum_idle" } }
		event = { time = 0 particle = "mjarchitect_portal_effect" keep_particle = yes trigger_once = yes sound = { soundeffect = "blackhole_hum_idle" } }
	}
	locator = { name = "centre" }
	attach = { "centre" = "mjarchitect_veil_frame_entity" }
	attach = { "centre" = "mjarchitect_veil_system_effect_entity" }
	
	game_data = {
		size = 1.0
		bloom_factor = 10
	}
	cull_radius = 500
}

