# Celestial Beacon System Effects
entity = {
	name = "mjarchitect_veil_system_effect_entity"
	locator = { name = "core" position = { 0 -5 0 }}
	scale = 15
	attach = { "core" = "mjarchitect_system_outer_entity" }
	attach = { "core" = "mjarchitect_systemS_mesh_entity" }
	attach = { "core" = "mjarchitect_systemXS_mesh_entity" }
	attach = { "core" = "mjarchitect_systemPoints_mesh_entity" }

	default_state = "idle"
	state = { name = "idle" 		state_time = 5
		event = { time = 0 node = "core" particle = "mjarchitect_veil_system_effect" keep_particle = yes trigger_once = yes }
		start_event = {
			trigger_once = yes
			sound = { soundeffect = "sfx_amb_gravity_storm" }
            }
        }

	cull_radius = 20000
}

