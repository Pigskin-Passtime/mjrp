entity = {
	name = "mjarchitect_veiled_planet_01_entity"
	pdxmesh = "planet_clouded_mesh"

	meshsettings = {
		name = "planet_geosphereShape"
		texture_diffuse = "mjarchitect_veiled_diffuse.dds"
		texture_normal = "frozen_01_normals.dds"
		texture_specular = "frozen_01_spec.dds"
	}
	
	# Poles
	meshsettings = {
		name = "polesShape"
		texture_diffuse = "mjarchitect_veiled_poles_diffuse.dds"
		texture_normal = "poles_1_normal.dds"
		texture_specular = "poles_1_specular.dds"
	}

	# Clouds
	meshsettings = {
		name = "clouds_geosphereShape"
		texture_diffuse = "mjarchitect_veiled_clouds_diffuse.dds"
		texture_normal = "toxic_clouds_normal.dds"
		texture_specular = "toxic_clouds_specular.dds"
	}

	# Cloud Shadows
	meshsettings = {
		name = "clouds_shadow_geosphereShape"
		texture_diffuse = "mjarchitect_veiled_clouds_shadow_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "nospec.dds"
	}

	default_state = "idle"
	state = { name = "idle" animation = "idle"
		start_event = { trigger_once = yes sound = { soundeffect = "amb_toxic_world_a" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_toxic_world_b" } }
		# start_event = { particle = "mjarchitect_portal_effect" keep_particle = yes trigger_once = yes sound = { soundeffect = "blackhole_hum_idle" } }
	}

	attach = { root = "mjarchitect_veiled_planet_effect_entity" }
}