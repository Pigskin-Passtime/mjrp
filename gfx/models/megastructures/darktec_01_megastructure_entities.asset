# Test
	entity = {
		name = "darktec_sphere_TEST_entity"

		# planet plane ring	
		locator = { name = "loc101" position = { 0 -30 0 } rotation = { 0 0 0 } }
		locator = { name = "loc102" position = { 0 0 0 } rotation = { 0 0 0 } }
		locator = { name = "loc103" position = { 0 0 0 } rotation = { 0 0 0 } }
		
		attach = { "loc101" = "darktec_bald_blackhole_phase_04_entity"}
		attach = { "loc102" = "darktec_vortex_phase_04_entity"}
		#attach = { "loc103" = "darktec_nebula_phase_04_entity"}
		
		state = { name = "idle" state_time = 100 time_offset = { 0 100 }
			#event = { time = 0 node = "loc101" particle = "interstellar_assembly_effect" keep_particle = yes trigger_once = yes }
			#start_event = { time = 0 node = "root" particle = "gatebuilder_gateway_portal_effect" keep_particle = yes trigger_once = yes }
			start_event = { trigger_once = yes sound = { soundeffect = "ringworld_hum_idle_01" } }
			start_event = { trigger_once = yes sound = { soundeffect = "ringworld_hum_idle_02" } }
		}
		cull_radius = 2000
	}
	entity = {
		name = "darktec_bald_blackhole_phase_TEST_entity"
		# I'm so sorry for the name
		pdxmesh = "darktec_odd_blackhole"

		default_state = "idle"
		state = { name = "idle" state_time = 5
			event = { time = 0 particle = "black_hole_particle" trigger_once = yes keep_particle = yes }
			#event = { trigger_once = yes sound = { soundeffect = "blackhole_hum_idle" } }
			event = { trigger_once = yes sound = { soundeffect = "dimensional_horror_portal" } }
		}
		locator = { name = "planet" }
		#attach = { "planet" = "black_hole_rings_entity" }
		attach = { "planet" = "black_hole_grav_lens_entity" }
		attach = { "planet" = "black_hole_grav_animation_entity" }
		
		game_data = {
			size = 5
			bloom_factor = 5
		}
		cull_radius = 700

		scale = 20
	}
	entity = {
		name = "darktec_vortex_phase_TEST_entity"
		locator = { name = "core" position = { 0 -5 0 }}
		scale = 60

		default_state = "idle"
		state = { name = "idle" 		state_time = 5
			event = { time = 0 node = "core" particle = "darktec_storm_1_effect" keep_particle = yes trigger_once = yes }
			start_event = { 
				trigger_once = yes 
				sound = { soundeffect = "sfx_amb_psi_storm_1" } 
				}
			}
		
		attach = { core = "psi_storm_core_entity" }

		cull_radius = 20000
	}
	entity = {	 # based on nebula_L16_entity
		name = "darktec_nebula_phase_TEST_entity"
			locator = { name = "root"  rotation = { 0 0 0 } }

		attach = { "root" = "nebula_core_2_entity" }
		#attach = { "root" = "nebula_6_entity" }

		attach = { "root" = "nebula_7_3_entity" }
		cull_radius = 2000

		scale = 0.3
	}
