
#### Storms
entity = {
	name = "dtm_space_storm_1_entity"
	locator = { name = "core" position = { 0 -5 0 }}
	scale = 20

	default_state = "idle"
	state = { name = "idle" 		state_time = 5
		event = { time = 0 node = "core" particle = "dtm_space_storm_1_2_effect" keep_particle = yes trigger_once = yes }
		start_event = { 
			trigger_once = yes 
			sound = { soundeffect = "sfx_amb_space_storm_1" } 
            }
        }
	
	cull_radius = 20000
}

