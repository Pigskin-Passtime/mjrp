entity = {
	name = "hcp_stellar_harvester_colossus_weapon_entity"
	pdxmesh = "synth_queen_system_locators_mesh"
	locator = { name = "root" rotation = {0 0 0 } }
	locator = { name = "root_2" rotation = {90 0 0 } scale = 0.9}
	locator = { name = "root_3" rotation = {-35 0 0 } scale = 1.1 }
	locator = { name = "root_4" rotation = {90 45 0 } scale = 1.1 }
	locator = { name = "root_5" rotation = {90 -45 0 } scale = 1.1 }
	scale = 25

	attach = { "root" = "synth_queen_system_cylinder_entity" }
	attach = { "root_2" = "hcp_stellar_harvester_swarm_effect_entity" }
	attach = { "root_3" = "hcp_stellar_harvester_swarm_effect_entity" }
	attach = { "root_4" = "hcp_stellar_harvester_swarm_effect_entity" }
	attach = { "root_5" = "hcp_stellar_harvester_swarm_effect_entity" }


	default_state = "explode"
	state = {
		name = "explode" looping = yes 	state_time = 5
	}
	
#	cull_radius = 3500

		
}

entity = {
	name = "hcp_stellar_harvester_swarm_effect_entity"
	pdxmesh = "synth_queen_system_swarm_mesh"

	scale = 0.7
		game_data = {
		bloom_factor			= 2
		uv_animation_speed 		= 1
		uv_animation_direction 	= { -0.6 1.0 }
		}		
}


