entity = {
	name = "pdivinity_shrouded_system_effect_entity"
	pdxmesh = "system_plane_collision_mesh"


	#	pdxmesh = "nemesis_system_effect_1_mesh"
	locator = { name = "root" }

	default_state = "idle"
	state = {		name = "idle"		state_time = 6
		event = {			time = 0 	particle = "pdivinity_shrouded_system_core_effect"		trigger_once = yes		keep_particle = yes	}
		start_event = { trigger_once = yes sound = { soundeffect = "amb_system_desolation_space" } }
	}


	game_data = {
		bloom_factor			= 1
		uv_animation_speed 		= 0.07
		uv_animation_direction 	= { 0.2 1.0 }
	}
	scale = 10
}

