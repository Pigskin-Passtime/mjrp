######################
### galactic storm ###
######################

entity = {
	name = "pdivinity_galatic_storm_entity"
	locator = { name = "core" position = { 0 -5 0 }}
	scale = 50

	default_state = "idle"
	state = { name = "idle" 		state_time = 5
		event = { time = 0 node = "core" particle = "pdivinity_galactic_storm_effect" keep_particle = yes trigger_once = yes }
		start_event = {
			trigger_once = yes
			sound = { soundeffect = "sfx_amb_psi_storm_1" }
		}
	}

	cull_radius = 20000
}

