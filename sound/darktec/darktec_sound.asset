	volume	= 1.0
}
sound = {
	name = "darktec_humanoid_male_greeting_10"
	file = "vo/darktec_humanoid_male_greeting_10.wav"
	volume	= 1.0
}

soundeffect = {	# Based on humanoid_male_greeting_a
	name = darktec_humanoid_greetings
	sounds = {
		sound = darktec_humanoid_male_greeting_07
		sound = darktec_humanoid_male_greeting_10
	}  
	volume = 0.9
}

