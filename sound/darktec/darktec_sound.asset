# sound\darktec\darktec_sound.asset

# Authors: Rodahtnov & Zyralynn

category = {
	name = "Effects"
	soundeffects = {
		darktec_humanoid_greetings
		darktec_beast_greetings
		darktec_insectoid_greetings
		darktec_molluscoid_greetings
		darktec_plantoid_greetings
		darktec_lithoid_greetings
		darktec_machine_greetings

		darktec_shield_collapse
		darktec_shield_collapse_distant
	}
}


soundeffect = {	# Based on darktec_extra_dimensional_station_death
	name = darktec_shield_collapse
	sounds = {
		sound = extra_dimensional_station_death_01
	}
	volume = 5
	falloff = falloff_weapons_xl
	is3d = yes
	max_audible = 1
	volume_random_offset = { -0.05 0.05 }
	max_audible_behaviour = fail
	playbackrate_random_offset = { 0.0 2.0 }
}
soundeffect = {	# Based on distance_extra_dimensional_station_death
	name = darktec_shield_collapse_distant
	sounds = {
		sound = distance_extra_dimensional_station_death_01
	}
	volume = 3
	falloff = falloff_weapons_xl
	is3d = yes
	max_audible = 1
	volume_random_offset = { -0.05 0.05 }
	max_audible_behaviour = fail
	playbackrate_random_offset = { 0.0 2.0 }
}


# Humanoid - humanoid_male_greeting_07 & humanoid_male_greeting_10
