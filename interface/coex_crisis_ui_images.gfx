### UI background - replace PATH

	progressbarType = {
		name = "GFX_coexistence_path_progressbar"
		color = { 1.0 1.0 1.0 }
		colorTwo = { 1.0 1.0 1.0 }
		textureFile1 = "gfx/interface/crisis/Crisis_progressBar_Filled.dds"
		textureFile2 = "gfx/interface/crisis/coex_coexistence_crisis_progress_bar.dds"
		size = { x = 10 y = 432 }
		effectFile = "gfx/FX/progress.shader"
		horizontal = no
		flipdirection = yes
