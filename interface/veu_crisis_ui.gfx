spriteTypes = {

### Crisis Resource - replace NAME
# Resource defined in common/strategic_resources

	spriteType = {
		name = "GFX_resource_NAME"
		texturefile = "gfx/interface/icons/resources/menace.dds"
	}

### Ascension Perk - replace NAME
# Defined in common/ascension_perks

