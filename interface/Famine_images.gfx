	# Potato Relic
	SpriteType = {
		name = "GFX_relic_potato"
		textureFile = "gfx/interface/icons/relics/r_kirby_mod_relic.dds"
		effectFile = "gfx/FX/buttonstate.shader"
		animation = {
			animationmaskfile = "gfx/interface/icons/relics/r_kirby_mod_relic_shine.dds"			
			animationtexturefile = "gfx/interface/icons/relics/glow_overlay.dds" 	# <- the animated file
			animationrotation = 90.0		
			animationlooping = yes			
			animationtime = 11				
			animationdelay = 0			
			animationblendmode = "add"      
			animationtype = "pulsing"
			animationrotationoffset = { x = 0.0 y = 0.0 }
			animationtexturescale = { x = 1.0 y = 1.0 }
		}
		legacy_lazy_load = no
	}
